# Copy to .env (next to compose.yaml) and edit. Everything but SITE_ADDRESS is optional: these are the defaults.

# Your domain, pointed at this machine. "localhost" gives a local test certificate and no real HTTPS.
SITE_ADDRESS=localhost

# How many proxies sit in front of the app and set X-Forwarded-For. Caddy alone: 1. Cloudflare then Caddy: 2 (and see Caddyfile).
# Get this wrong and every visitor shares one rate limit (too low), or visitors can dodge it (too high).
MERITFINDER_TRUST_PROXY_HOPS=1

# 1 when served over HTTPS (it is, through Caddy): adds HSTS and upgrade-insecure-requests.
MERITFINDER_HTTPS=1

# The public address, used for the canonical link, sitemap and share card. Set it to your own domain.
MERITFINDER_SITE_URL=https://meritfinder.app

# Searches per minute per visitor, and across everyone. 0 turns the limit off.
MERITFINDER_RATE_LIMIT=30
MERITFINDER_RATE_LIMIT_GLOBAL=600
MERITFINDER_RATE_LIMIT_SUGGEST=120

# How long one search may run before it returns what it has, in ms.
MERITFINDER_SEARCH_BUDGET_MS=2000

# How long identical searches are answered from memory, in seconds. 0 = off.
MERITFINDER_CACHE_TTL_SECONDS=300

# If above 0, search answers carry Cache-Control so a CDN in front may keep them this many seconds.
MERITFINDER_CDN_CACHE_SECONDS=0
